# Copy to ignored .env for LOCAL development; never commit credentials.
# Cloud deployment settings belong in the selected ignored azd environment.

# Foundry project/model: use your environment's real endpoint, not another demo's.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-5.4-mini
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_TENANT_ID=

# local = in-process development; hosted = protected deployment's normal mode.
# containerapp is an optional legacy/local adapter, not a sixth deployed service.
AGENT_MODE=local

# Hosted gateway: project URL, or optional exact HTTPS Responses URL override.
HOSTED_AGENT_ENDPOINT=
HOSTED_AGENT_NAME=fibey-agent
# HOSTED_AGENT_RESPONSES_URL=
HOSTED_TIMEOUT_SECONDS=600

# Local toolbox endpoint; a supplied ?api-version=v1 is accepted.
# Example: https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/fibey-toolbox/mcp?api-version=v1
TOOLBOX_MCP_URL=
# Hosted SDK: resolves from TOOLBOX_ENDPOINT, or project endpoint + TOOLBOX_NAME.
TOOLBOX_NAME=fibey-toolbox
# TOOLBOX_ENDPOINT=
SKILLS_SOURCE=auto
ENABLE_SENSITIVE_TELEMETRY=false

# Exact comma-separated origins only. Leave empty for same-origin UI/Vite proxy.
CORS_ORIGINS=

# Optional legacy agent-service URL, only when AGENT_MODE=containerapp.
# CONTAINERAPP_AGENT_URL=http://127.0.0.1:8004

# Optional local direct-Search fallback when no toolbox is configured.
# These do not configure the protected cloud Foundry IQ connection.
# AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=foundry-iq-docs-index
# AZURE_SEARCH_API_KEY=

# Only the deployed Nginx UI container requires these; Vite uses its local proxy.
# GATEWAY_HOST=<internal-gateway-host>
# GATEWAY_URL=https://<internal-gateway-host>/api/

# Required cloud secrets/settings are supplied through azd, not this example:
# UI_CLIENT_ID, UI_CLIENT_SECRET, AZURE_PRINCIPAL_ID (allowed user object ID),
# INVENTORY_API_KEY, WORK_ORDERS_API_KEY (separate random values, >=32 characters).
# Backend containers receive their own API_KEY and REQUIRE_API_KEY=true.
# Inventory receives STATUS_DASHBOARD_URL for the fixed internal dashboard.
